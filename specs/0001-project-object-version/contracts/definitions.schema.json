{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Torii SPEC-0001 definition contract, revision 0.2 (In review)",
  "oneOf": [
    {
      "$ref": "#/$defs/DatasetDefinition"
    },
    {
      "$ref": "#/$defs/TransformationDefinition"
    }
  ],
  "$defs": {
    "ParameterValue": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 4096
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      ]
    },
    "Parameters": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/ParameterValue"
      }
    },
    "InputPort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "data_kind": {
          "const": "tabular"
        },
        "dataset_object_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "name",
        "data_kind"
      ]
    },
    "OutputPort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "data_kind": {
          "const": "tabular"
        }
      },
      "required": [
        "name",
        "data_kind"
      ]
    },
    "FileSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connector": {
          "const": "file"
        },
        "format": {
          "enum": [
            "csv",
            "parquet"
          ]
        },
        "binding": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      },
      "required": [
        "connector",
        "format",
        "binding"
      ]
    },
    "SqlSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connector": {
          "const": "postgresql"
        },
        "connection_binding": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "parameters": {
          "$ref": "#/$defs/Parameters"
        }
      },
      "required": [
        "connector",
        "connection_binding",
        "query",
        "parameters"
      ]
    },
    "PythonImplementation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "const": "python"
        },
        "module": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "callable": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "language",
        "module",
        "callable"
      ]
    },
    "SqlImplementation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "const": "sql"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "connection_binding": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      },
      "required": [
        "language",
        "query",
        "connection_binding"
      ]
    },
    "DatasetDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "dataset"
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/FileSource"
            },
            {
              "$ref": "#/$defs/SqlSource"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "source"
      ]
    },
    "TransformationDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "transformation"
        },
        "implementation": {
          "oneOf": [
            {
              "$ref": "#/$defs/PythonImplementation"
            },
            {
              "$ref": "#/$defs/SqlImplementation"
            }
          ]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/InputPort"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/OutputPort"
          }
        },
        "parameters": {
          "$ref": "#/$defs/Parameters"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "implementation",
        "inputs",
        "outputs",
        "parameters"
      ]
    }
  }
}
