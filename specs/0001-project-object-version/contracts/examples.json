  "semantic_only": [
    {
      "id": "cross-project-reference",
      "base": "transformation-python",
      "expected": "422 invalid_reference",
      "note": "UUID is syntactically valid but refers to project P2; requires runtime DB/authorization test."
    },
    {
      "id": "duplicate-port-name",
      "base": "transformation-python",
      "expected": "422 validation_failed",
      "note": "Duplicate named ports are a domain invariant, not covered by JSON Schema uniqueItems."
    },
    {
      "id": "last-owner-race",
      "expected": "409 last_owner",
      "note": "Requires concurrent transactions, not schema validation."
    }
  ]
