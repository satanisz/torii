  "valid": [
    {
      "id": "dataset-csv",
      "definition": {
        "schema_version": "1.0",
        "kind": "dataset",
        "source": {
          "connector": "file",
          "format": "csv",
          "binding": "deliveries"
        }
      }
    },
    {
      "id": "dataset-parquet",
      "definition": {
        "schema_version": "1.0",
        "kind": "dataset",
        "source": {
          "connector": "file",
          "format": "parquet",
          "binding": "prepared"
        }
      }
    },
    {
      "id": "dataset-sql",
      "definition": {
        "schema_version": "1.0",
        "kind": "dataset",
        "source": {
          "connector": "postgresql",
          "connection_binding": "warehouse",
          "query": "SELECT order_id FROM deliveries WHERE day >= :min_day",
          "parameters": {
            "min_day": "2026-09-01"
          }
        }
      }
    },
    {
      "id": "transformation-python",
      "definition": {
        "schema_version": "1.0",
        "kind": "transformation",
        "implementation": {
          "language": "python",
          "module": "delivery_project.features",
          "callable": "prepare"
        },
        "inputs": [
          {
            "name": "raw",
            "data_kind": "tabular",
            "dataset_object_id": "10000000-0000-4000-8000-000000000001"
          }
        ],
        "outputs": [
          {
            "name": "prepared",
            "data_kind": "tabular"
          }
        ],
        "parameters": {
          "drop_duplicates": true
        }
      }
    },
    {
      "id": "transformation-sql",
      "definition": {
        "schema_version": "1.0",
        "kind": "transformation",
        "implementation": {
          "language": "sql",
          "connection_binding": "warehouse",
          "query": "SELECT order_id FROM input_deliveries"
        },
        "inputs": [
          {
            "name": "input_deliveries",
            "data_kind": "tabular"
          }
        ],
        "outputs": [
          {
            "name": "prepared",
            "data_kind": "tabular"
          }
        ],
        "parameters": {}
      }
    }
  ],
